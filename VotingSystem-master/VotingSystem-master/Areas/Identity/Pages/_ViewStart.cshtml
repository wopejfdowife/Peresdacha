@* Блок кода Razor — настройка макета для всех страниц в этой папке и подпапках *@
@{
    // Установка макета (layout) на главный макет сайта
    // Путь начинается с /Views/Shared/, т.к. Areas — отдельный модуль
    // Это связывает страницы Identity с основным шаблоном сайта
    Layout = "/Views/Shared/_Layout.cshtml";
}