@* Регистрация страницы как Razor Page *@
@page
@* Модель страницы: IndexModel *@
@model IndexModel
@* Настройка страницы *@
@{
    // Заголовок страницы — «Профиль»
    ViewData["Title"] = "Профиль";
    // Активный пункт меню навигации (для подсветки в _ManageNav)
    ViewData["ActivePage"] = ManageNavPages.Index;
}

@* Заголовок страницы *@
<h3>@ViewData["Title"]</h3>
@* Вставка частичного представления для отображения сообщений StatusMessage *@
<partial name="_StatusMessage" for="StatusMessage" />
@* Двухколоночная раскладка *@
<div class="row">
    @* Левая колонка — форма профиля *@
    <div class="col-md-6">
        @* Форма профиля *@
        <form id="profile-form" method="post">
            @* Блок общих ошибок формы *@
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @* Поле «Имя пользователя» (только для чтения) *@
            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold">Имя пользователя</label>
                @* disabled — поле не редактируется *@
                <input asp-for="Username" class="form-control" disabled style="padding-left: 12px;" />
            </div>
            @* Поле «Номер телефона» *@
            <div class="mb-3">
                <label asp-for="Input.PhoneNumber" class="form-label fw-semibold">Номер телефона</label>
                @* Поле ввода номера телефона *@
                <input asp-for="Input.PhoneNumber" class="form-control" style="padding-left: 12px;" />
                @* Место отображения ошибки валидации *@
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
            </div>
            @* Кнопка «Сохранить» *@
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">
                <i class="bi bi-check-lg"></i> Сохранить
            </button>
        </form>
    </div>
</div>

@* Секция Scripts: подключение клиентской валидации *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}