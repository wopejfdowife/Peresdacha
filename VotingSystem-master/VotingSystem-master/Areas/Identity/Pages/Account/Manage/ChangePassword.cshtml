@* Регистрация страницы как Razor Page *@
@page
@* Модель страницы: ChangePasswordModel *@
@model ChangePasswordModel
@* Настройка страницы *@
@{
    // Заголовок страницы — «Смена пароля»
    ViewData["Title"] = "Смена пароля";
    // Активный пункт меню навигации
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

@* Заголовок страницы *@
<h3>@ViewData["Title"]</h3>
@* Сообщение о статусе *@
<partial name="_StatusMessage" for="StatusMessage" />
@* Двухколоночная раскладка *@
<div class="row">
    <div class="col-md-6">
        @* Форма смены пароля *@
        <form id="change-password-form" method="post">
            @* Блок общих ошибок формы *@
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @* Поле «Текущий пароль» *@
            <div class="mb-3">
                <label asp-for="Input.OldPassword" class="form-label fw-semibold">Текущий пароль</label>
                @* Поле ввода текущего пароля *@
                @* autocomplete="current-password" — подсказка браузеру *@
                <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" style="padding-left: 12px;" />
                @* Ошибка валидации *@
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>
            @* Поле «Новый пароль» *@
            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label fw-semibold">Новый пароль</label>
                @* Поле ввода нового пароля *@
                @* autocomplete="new-password" — подсказка для нового пароля *@
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" style="padding-left: 12px;" />
                @* Ошибка валидации *@
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>
            @* Поле «Подтверждение нового пароля» *@
            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Подтвердите новый пароль</label>
                @* Поле подтверждения *@
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" style="padding-left: 12px;" />
                @* Ошибка валидации *@
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            @* Кнопка «Обновить пароль» *@
            <button type="submit" class="w-100 btn btn-lg btn-primary">
                <i class="bi bi-key"></i> Обновить пароль
            </button>
        </form>
    </div>
</div>

@* Секция Scripts: клиентская валидация *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}