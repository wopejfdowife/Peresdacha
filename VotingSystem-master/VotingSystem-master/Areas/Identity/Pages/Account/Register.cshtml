@* Регистрация страницы как Razor Page *@
@page
@* Модель страницы: RegisterModel *@
@model RegisterModel
@* Настройка страницы *@
@{
    // Заголовок — «Регистрация»
    ViewData["Title"] = "Регистрация";
}

@* Заголовок страницы *@
<h1 class="mb-4">@ViewData["Title"]</h1>

@* Двухколоночная раскладка *@
<div class="row">
    @* Левая колонка — форма регистрации *@
    <div class="col-md-6">
        @* Форма регистрации *@
        @* ID — registerForm, returnUrl из модели *@
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="needs-validation">
            @* Подзаголовок *@
            <h5 class="mb-3 text-muted">Создание нового аккаунта</h5>
            @* Разделитель *@
            <hr />
            @* Блок общих ошибок формы *@
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @* Ряд из двух полей: Фамилия и Имя *@
            <div class="row">
                @* Поле «Фамилия» *@
                <div class="col-md-6 mb-3">
                    @* Подпись поля с звёздочкой (обязательно) *@
                    <label asp-for="Input.LastName" class="form-label fw-semibold">Фамилия <span class="text-danger">*</span></label>
                    @* Поле ввода фамилии *@
                    <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" style="padding-left: 12px;" />
                    @* Место отображения ошибки валидации *@
                    <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                </div>
                @* Поле «Имя» *@
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.FirstName" class="form-label fw-semibold">Имя <span class="text-danger">*</span></label>
                    <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" style="padding-left: 12px;" />
                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                </div>
            </div>
            @* Поле «Регион» *@
            <div class="mb-3">
                <label asp-for="Input.Region" class="form-label fw-semibold">Регион</label>
                <input asp-for="Input.Region" class="form-control" autocomplete="region" style="padding-left: 12px;" />
                <span asp-validation-for="Input.Region" class="text-danger small"></span>
            </div>
            @* Поле «Email» *@
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" style="padding-left: 12px;" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            @* Поле «Пароль» *@
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold">Пароль <span class="text-danger">*</span></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" style="padding-left: 12px;" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            @* Поле «Подтверждение пароля» *@
            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Подтвердите пароль <span class="text-danger">*</span></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" style="padding-left: 12px;" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            @* Кнопка «Зарегистрироваться» *@
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">
                <i class="bi bi-person-plus"></i> Зарегистрироваться
            </button>
        </form>
    </div>
    @* Правая колонка — информационный блок *@
    <div class="col-md-6 d-flex align-items-center">
        @* Серая карточка с иконкой и текстом *@
        <div class="card bg-light border-0 w-100">
            <div class="card-body text-center py-5">
                @* Иконка щита (синего/зелёного цвета) *@
                <i class="bi bi-shield-check text-success" style="font-size: 4rem;"></i>
                @* Заголовок *@
                <h5 class="mt-3">Участвуйте в голосовании</h5>
                @* Описание *@
                <p class="text-muted">Зарегистрируйтесь, чтобы голосовать за кандидатов и проекты благоустройства города Владикавказ</p>
            </div>
        </div>
    </div>
</div>

@* Секция Scripts: подключение клиентской валидации формы *@
@section Scripts {
    @* Вставка частичного представления с jQuery Validation скриптами *@
    <partial name="_ValidationScriptsPartial" />
}