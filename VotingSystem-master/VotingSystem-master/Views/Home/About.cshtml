@* Директива @model — тип модели для страницы: список информации о разработчиках *@
@model List<DeveloperInfo>
@* Блок настройки страницы *@
@{
    // Заголовок страницы — «О проекте»
    ViewData["Title"] = "О проекте";
}

@* Заголовок страницы с отступом снизу *@
<h1 class="mb-4">О проекте</h1>

@* Блок описания проекта (карточка с тенью) *@
<div class="row mb-4">
    <div class="col">
        <div class="card shadow-sm">
            <div class="card-body">
                @* Заголовок карточки с иконкой ✅ *@
                <h5 class="card-title">
                    <i class="bi bi-check2-square text-primary"></i> Система голосования г. Владикавказ
                </h5>
                @* Параграф с описанием назначения системы *@
                <p class="card-text">
                    Данная система разработана для проведения электронного голосования
                    на территории города Владикавказ. Мы стремимся сделать процесс голосования
                    максимально прозрачным, удобным и доступным для каждого жителя.
                </p>
                @* Ряд с тремя блоками информации (технологии, дата, место) *@
                <div class="row mt-3">
                    @* Блок «Технологии» *@
                    <div class="col-md-4 mb-2">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-gear me-2 text-primary"></i>
                            <span><strong>Технологии:</strong> ASP.NET Core MVC, EF Core, SQLite, Bootstrap, JSON</span>
                        </div>
                    </div>
                    @* Блок «Дата» *@
                    <div class="col-md-4 mb-2">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-calendar me-2 text-primary"></i>
                            <span><strong>Дата:</strong> Май 2026 года</span>
                        </div>
                    </div>
                    @* Блок «Место» *@
                    <div class="col-md-4 mb-2">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-geo-alt me-2 text-primary"></i>
                            <span><strong>Место:</strong> СОГУ, ул. Ватутина 22</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Заголовок раздела «Команда разработчиков» *@
<h2 class="mb-3">Команда разработчиков</h2>

@* Ряд карточек разработчиков *@
<div class="row mb-4">
    @* Цикл перебора списка разработчиков (Model) *@
    @foreach (var dev in Model)
    {
        @* Колонка: треть ряда на md-экранах *@
        <div class="col-md-4 mb-4">
            @* Карточка с иконкой профиля, именем, ролью и описанием *@
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    @* Иконка профиля (серого цвета, размер 4rem) *@
                    <i class="bi bi-person-circle text-secondary" style="font-size: 4rem;"></i>
                    @* Имя разработчика *@
                    <h5 class="card-title mt-3">@dev.FullName</h5>
                    @* Роль разработчика (серый текст) *@
                    <h6 class="card-subtitle mb-2 text-muted">@dev.Role</h6>
                    @* Описание вклада в проект *@
                    <p class="card-text">@dev.Description</p>
                </div>
            </div>
        </div>
    }
</div>

@* Заголовок раздела «О городе» *@
<h2 class="mb-3">О городе</h2>
@* Карточка с текстом о городе Владикавказе *@
<div class="card shadow-sm mb-4">
    <div class="card-body">
        @* Эмблема «сердце» + подзаголовок *@
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-heart text-danger me-2" style="font-size: 2rem;"></i>
            <h4 class="mb-0">Владикавказ — город, в котором хочется жить!</h4>
        </div>
        @* Параграф 1: общее описание города *@
        <p>
            <strong>Владикавказ</strong> (осет. Дзæуджыхъæu) — столица Республики Северная Осетия-Алания,
            один из красивейших городов Северного Кавказа. Основанный в 1784 году, он раскинулся
            в живописной долине у подножия Кавказских гор, где бурные воды Терека придают особый шарм
            этому удивительному месту.
        </p>
        @* Параграф 2: описание современного состояния города *@
        <p>
            Сегодня Владикавказ — это современный, динамично развивающийся город, где бережно хранят
            богатейшее культурное наследие осетинского народа. Здесь переплелись вековые традиции
            и инновации, величественные горы и уютные парки, древние обычаи и современный ритм жизни.
        </p>
        @* Параграф 3: идея проекта *@
        <p>
            Каждый из нас хочет видеть свой город ещё лучше, чище и комфортнее. Именно поэтому
            мы создали эту систему — чтобы каждый житель Владикавказа мог внести свой вклад
            в развитие города, проголосовать за достойных кандидатов и поддержать проекты
            благоустройства, которые сделают наш общий дом ещё прекраснее.
        </p>
    </div>
</div>

@* Заголовок раздела «Голосование за районы» *@
<h2 class="mb-3">Голосование за районы</h2>
@* Карточка с описанием функционала голосования за районы *@
<div class="card shadow-sm mb-4">
    <div class="card-body">
        @* Эмблема «здания» + подзаголовок *@
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-buildings text-success me-2" style="font-size: 2rem;"></i>
            <h4 class="mb-0">Проекты благоустройства районов</h4>
        </div>
        @* Параграф 1: описание районов в системе *@
        <p>
            В системе реализовано голосование за проекты благоустройства по четырём районам Владикавказа:
            <strong>Затеречный, Иристонский, Промышленный, Северо-Западный</strong>.
            Каждый район включает по 4 проекта: от ремонта дорог и строительства парков до модернизации освещения и спортивных площадок.
        </p>
        @* Параграф 2: описание условий голосования *@
        <p>
            Авторизованные пользователи могут проголосовать за понравившиеся проекты в каждом районе.
            Результаты голосования учитываются при планировании городских программ благоустройства.
        </p>
        @* Кнопка-ссылка на страницу районов *@
        <a asp-controller="Districts" asp-action="Index" class="btn btn-success">
            <i class="bi bi-eye"></i> Перейти к районам
        </a>
    </div>
</div>

@* Блок-уведомление «призыв к действию» *@
<div class="alert alert-success mt-3">
    <i class="bi bi-megaphone"></i>
    @* Жирный текст призыва *@
    <strong>Не оставайтесь в стороне!</strong> Ваш голос важен для будущего нашего города.
    Примите участие в голосовании прямо сейчас!
</div>