@* Блок кода C#: настройка страницы Главная *@
@{
    // Задание заголовка страницы — «Главная» (отображается во вкладке браузера)
    ViewData["Title"] = "Главная";
}

@* Центрированный контейнер с изображением города Владикавказ *@
<div class="text-center mb-4">
    @* Изображение города: адаптивная ширина, скруглённые углы, тень, ограничение высоты 300px *@
    <img src="/images/vladikavkaz.svg" alt="Владикавказ" class="img-fluid rounded shadow-sm mb-4" style="max-height: 300px; width: 100%; object-fit: cover;" />
    @* Главный заголовок главной страницы *@
    <h1 class="display-4">Система голосования</h1>
    @* Подзаголовок с описанием системы (серый цвет) *@
    <p class="lead text-muted">Электронное голосование города Владикавказ</p>
    @* Горизонтальная линия-разделитель *@
    <hr class="my-4" />
</div>

@* Ряд с тремя карточками-разделами (карточки равной высоты, с отступами между ними) *@
<div class="row g-4">
    @* Колонка 1 (занимает половину ряда на md-экранах, треть на lg) — карточка «Кандидаты» *@
    <div class="col-md-6 col-lg-4">
        @* Карточка с рамкой синего цвета (border-primary) *@
        <div class="card h-100 shadow-sm border-primary">
            @* Тело карточки с центрированным текстом *@
            <div class="card-body text-center">
                @* Большая иконка группы людей (синего цвета, размер 3rem) *@
                <i class="bi bi-people-fill text-primary" style="font-size: 3rem;"></i>
                @* Заголовок карточки *@
                <h5 class="card-title mt-3">Голосование за кандидатов</h5>
                @* Описание карточки *@
                <p class="card-text text-muted">Просмотрите список кандидатов и отдайте свой голос за достойного представителя</p>
                @* Кнопка-ссылка на страницу кандидатов *@
                <a asp-controller="Candidates" asp-action="Index" class="btn btn-primary">
                    Перейти к кандидатам
                </a>
            </div>
        </div>
    </div>
    @* Колонка 2 — карточка «Благоустройство районов» *@
    <div class="col-md-6 col-lg-4">
        @* Карточка с зелёной рамкой (border-success) *@
        <div class="card h-100 shadow-sm border-success">
            @* Тело карточки с центрированным текстом *@
            <div class="card-body text-center">
                @* Большая иконка зданий (зелёного цвета) *@
                <i class="bi bi-buildings-fill text-success" style="font-size: 3rem;"></i>
                @* Заголовок карточки *@
                <h5 class="card-title mt-3">Благоустройство районов</h5>
                @* Описание карточки *@
                <p class="card-text text-muted">Выберите проекты по улучшению инфраструктуры районов Владикавказа</p>
                @* Кнопка-ссылка на страницу районов *@
                <a asp-controller="Districts" asp-action="Index" class="btn btn-success">
                    К проектам
                </a>
            </div>
        </div>
    </div>
    @* Колонка 3 — карточка «О проекте» *@
    <div class="col-md-6 col-lg-4">
        @* Карточка с голубой рамкой (border-info) *@
        <div class="card h-100 shadow-sm border-info">
            @* Тело карточки с центрированным текстом *@
            <div class="card-body text-center">
                @* Большая иконка информации (голубого цвета) *@
                <i class="bi bi-info-circle-fill text-info" style="font-size: 3rem;"></i>
                @* Заголовок карточки *@
                <h5 class="card-title mt-3">О проекте</h5>
                @* Описание карточки *@
                <p class="card-text text-muted">Узнайте о разработчиках системы и используемых технологиях</p>
                @* Кнопка-ссылка на страницу «О проекте» (белый текст на голубом фоне) *@
                <a asp-controller="Home" asp-action="About" class="btn btn-info text-white">
                    Подробнее
                </a>
            </div>
        </div>
    </div>
</div>

@* Условие: если пользователь НЕ авторизован (IsAuthenticated != true или null) — показать приглашение войти *@
@if (!User.Identity?.IsAuthenticated ?? true)
{
    @* Блок с приглашением зарегистрироваться/войти, отделённый отступом сверху *@
    <div class="row mt-5">
        @* Центрированная колонка *@
        <div class="col text-center">
            @* Серый фон с внутренними отступами и скруглением *@
            <div class="p-4 bg-light rounded">
                @* Заголовок приглашения *@
                <h4>Примите участие в голосовании</h4>
                @* Подпись под заголовком *@
                <p class="text-muted">Зарегистрируйтесь или войдите, чтобы голосовать</p>
                @* Ссылка на регистрацию (синяя кнопка) *@
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary me-2">
                    <i class="bi bi-person-plus"></i> Регистрация
                </a>
                @* Ссылка на вход (кнопка с контуром) *@
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Войти
                </a>
            </div>
        </div>
    </div>
}